# ShortsAI configuration
#
# You do NOT have to edit this file by hand — start the app and click "Setup"
# in the top-right of the web page to paste your keys there instead.
#
# Copy to .env if you prefer editing manually:   cp .env.example .env

# ── Keys ──────────────────────────────────────────────────────────────────────
# Free. The DEFAULT clip picker. Gemini Flash has a huge context window, so it reads
# an entire long transcript in ONE call instead of a dozen rate-limited ones.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free credit. Best Hindi transcription (nova-3), and what the captions are timed
# from.  https://console.deepgram.com/signup
DEEPGRAM_API_KEY=

# REQUIRED (free): transcription fallback + an alternative clip picker.
#   https://console.groq.com/keys
GROQ_API_KEY=

# Optional last-resort text fallback (one key, many models).
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Fallback order (defaults are fine) ────────────────────────────────────────
# Each capability walks its list until one provider succeeds.
# CHAT_ORDER=gemini,groq,openrouter
# TRANSCRIBE_ORDER=deepgram,groq,local
# CLIP_TRANSCRIBE_ORDER=deepgram,groq,local

# ── Clip selection on long videos ─────────────────────────────────────────────
# A transcript too big for one call is split into chunks and the picks are merged
# and then ranked against each other. Chunk size is chosen automatically per model
# (Gemini gets a very large one, Groq a small one to stay inside its 12k
# tokens/minute free tier) — set this only to override that.
# SELECTION_CHUNK_CHARS=240000   # large => whole transcript in ONE call
# SELECTION_MAX_CHUNKS=16        # hard ceiling on selection calls per job
# SELECTION_CHUNK_PAUSE=0        # seconds between chunks, for very small free tiers
# GEMINI_MODEL=                  # override the default Gemini model ladder

# ── Offline fallbacks (no API key, never rate-limited) ────────────────────────
# Transcription:  pip install faster-whisper
# LOCAL_WHISPER_MODEL=small        # small | medium | large-v3
# LOCAL_WHISPER_DEVICE=auto        # auto | cuda | cpu

# ── Performance ───────────────────────────────────────────────────────────────
# FFMPEG_ENCODER=auto              # auto | nvenc | amf | qsv | cpu
# ENCODE_CQ=23                     # lower = better quality, bigger files
# MAX_RENDER_WORKERS=2             # parallel renders; auto-scales by RAM if unset
# SUBTITLE_ENGINE=deepgram         # deepgram | whisper

# ── Timeouts (seconds) ────────────────────────────────────────────────────────
# DOWNLOAD_TIMEOUT=3600
# RENDER_TIMEOUT=1800

# ── Security ──────────────────────────────────────────────────────────────────
# The in-app Setup panel only accepts key changes from this machine. Set to 1
# ONLY on a trusted network if you need to configure keys from another device.
# ALLOW_REMOTE_SETTINGS=0
